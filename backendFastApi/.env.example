# Copia este archivo como .env y rellena tus valores. No subas nunca el .env al repositorio.

# PostgreSQL con la extensión PostGIS
# Con docker compose no hace falta: se configura automáticamente
DATABASE_URL=postgresql+psycopg2://pinfood:pinfood@localhost:5432/pinfood

# Client ID web de Google OAuth (el mismo que usa la app Flutter para pedir el ID token)
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Cloudinary (subida de fotografías)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
